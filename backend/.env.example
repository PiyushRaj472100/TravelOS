APP_NAME=TravelOS API
ENVIRONMENT=development
DEBUG=true
OPENAI_API_KEY=
MAPS_API_KEY=
WEATHER_API_KEY=

# =============================================================================
# Analytics Data Warehouse Configuration (Google BigQuery)
# =============================================================================
ANALYTICS_ENABLED=true
ANALYTICS_ENGINE=bigquery
BIGQUERY_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET_ID=travelos_analytics
GOOGLE_APPLICATION_CREDENTIALS=gcp-service-account.json

# (Optional) Microsoft SQL Server Configuration
# SQL_SERVER_HOST=localhost
# SQL_SERVER_PORT=1433
# SQL_SERVER_DATABASE=TravelOS_Analytics
# SQL_SERVER_USER=travelos_app
# SQL_SERVER_PASSWORD=YourStrongPasswordHere!
# SQL_SERVER_ODBC_DRIVER=ODBC Driver 17 for SQL Server


